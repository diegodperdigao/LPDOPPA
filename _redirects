# Links de tracking "limpos": redirect 301 que injeta a btag como ?btag= (metodo
# comprovado: a captura por query funciona; o rewrite 200 por PATH nao preservava o
# caminho no Cloudflare, entao a btag nunca era capturada). O JS le a btag, limpa a
# URL pra "/" e mantem fbclid/gclid. Planilha via BTAG_LABELS.
# /tp = Tráfego Pago · streamers: /flp = Flupy · /knz = Kennzy · /slv = Slavision40k · /bgd = Bugado · /lvl = Level Up · /dkt = dukoth · /gvn = guiven · /glg = galeguins
/tp /?btag=trafego-pago 301
/tp/ /?btag=trafego-pago 301
/flp /?btag=flp 301
/flp/ /?btag=flp 301
/knz /?btag=knz 301
/knz/ /?btag=knz 301
/slv /?btag=slv 301
/slv/ /?btag=slv 301
/bgd /?btag=bgd 301
/bgd/ /?btag=bgd 301
/lvl /?btag=lvl 301
/lvl/ /?btag=lvl 301
/dkt /?btag=dkt 301
/dkt/ /?btag=dkt 301
/gvn /?btag=gvn 301
/gvn/ /?btag=gvn 301
/glg /?btag=glg 301
/glg/ /?btag=glg 301

# Curinga self-service: crie quantos links quiser SEM mexer no codigo.
#   /s/<nome> = streamer   ->  planilha "Streamer: <nome>"
#   /t/<nome> = trafego pago -> "Tráfego Pago: <nome>"
#   /a/<nome> = afiliado    -> "Afiliado: <nome>"
# Ex.: doppa.com.br/s/galeguins  ->  ?btag=str-galeguins  ->  "Streamer: galeguins"
/s/:code /?btag=str-:code 301
/t/:code /?btag=tp-:code 301
/a/:code /?btag=af-:code 301
